extends "res://tests/keyboard_scene_test.gd"
func run() -> void:
    lobby = load("res://main.tscn").instantiate()
    root.add_child(lobby)
    await frames(2)
    lobby.session.set_focus(true)
    lobby.get_node("CombatPreview").pressed.emit()
    await frames(2)
    var b = lobby.arena.battle
    tap_key(KEY_Q)
    key_event(KEY_G,true)
    await frames(16)
    check(b.guarding,"holding guard during dodge raises shield when dodge ends")
    key_event(KEY_G,false)
    check(not b.guarding,"releasing buffered guard lowers shield immediately")
    await frames(35)
    key_event(KEY_G,true)
    tap_key(KEY_Q)
    await frames(16)
    check(b.guarding,"guard already held resumes after dodge without a second press")
    tap_key(KEY_ESCAPE)
    tap_key(KEY_ENTER)
    await frames(3)
    check(not b.guarding,"pause still clears held guard instead of replaying it")
    lobby.session.pause_all()
    lobby.start_solo_combat()
    await frames(2)
    b = lobby.arena.battle
    tap_key(KEY_Q)
    key_event(KEY_G,true)
    await frames(16)
    check(b.guarding,"solo player also retains guard input across dodge")
    tap_key(KEY_TAB)
    await frames(3)
    # Switching clears human intent immediately; the existing AI shield handoff
    # lasts at most 0.35 seconds and must not turn a key release into permanent guard.
    check(not b.guard_held,"switching solo role clears the original human guard intent")
    check(lobby.arena.solo.guard_handoff > 0 and lobby.arena.solo.guard_handoff <= 0.35 and b.guarding,"brief AI guard handoff retains the committed shield")
    key_event(KEY_G,false)
    await frames(24)
    check(lobby.arena.solo.guard_handoff == 0 and not b.guard_held and not b.guarding,"original guard release plus elapsed handoff lowers the shield")
    await frames(12)
    check(not b.guarding,"stopped handoff never becomes permanent guard")
    lobby.queue_free()
    await frames(4)
    var deadline := Time.get_ticks_msec()+100
    while Time.get_ticks_msec()<deadline: await process_frame
    print("M19_GUARD_INPUT: %d checks, %d failed" % [checks,failed])
    quit(1 if failed else 0)
