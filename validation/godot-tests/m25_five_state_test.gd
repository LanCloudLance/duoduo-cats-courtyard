extends SceneTree
const State = preload("res://game/chapter_five_state.gd")
var failed := 0
var checks := 0
func check(value:bool,description:String)->void:
    checks+=1
    if not value:failed+=1;push_error(description)
func tick(s,seconds:float,enabled:=true,a:=Vector2.ZERO,b:=Vector2.ZERO)->void:
    for i in range(ceili(seconds/0.05)):s.step(0.05,a,b,enabled)
# Positions below are explicit state-test fixtures. Full scene driver uses movement input.
func at(s,role:int,p:Vector2)->void:s.positions[role]=p;s.action_time[role]=0
func gather(s,p:Vector2)->void:
    at(s,0,p);at(s,1,p+Vector2(-40,35));at(s,2,p+Vector2(-65,-25))
func shield_attempt(s,correct:bool)->void:
    s.guard(0,false)
    while fmod(s.boss_clock,4.6)<0.8 or fmod(s.boss_clock,4.6)>1.1:tick(s,0.05)
    at(s,0,s.SHIELD_SLOT)
    s.facing[0]=s.positions[0].direction_to(s.MACHINE) if correct else Vector2.LEFT
    s.guard(0,true);tick(s,1.1)
func _initialize()->void:
    var s=State.new()
    check(s.joined and s.available_roles()==[0,1,2],"all three begin chapter five together")
    check(not s.walkable(Vector2(422,545),0),"unfixed gap blocks walking")
    at(s,0,s.LOW_LOCK);s.interact(0);check(not s.route_lock,"girl cannot substitute for hook")
    at(s,1,s.LOW_LOCK);s.interact(1)
    at(s,2,s.ROUTE_LAMP);s.interact(2);check(not s.bridge_locked,"light alone cannot replace platform support")
    at(s,0,s.SUPPORT);s.interact(0)
    s.facing[2]=Vector2.LEFT;s.interact(2);check(not s.bridge_locked,"wrong direction cannot light approach")
    s.facing[2]=Vector2.RIGHT;s.interact(2)
    check(s.bridge_locked and s.walkable(Vector2(422,545),0),"three learned tools lock permanent bridge")
    check(not s.walkable(Vector2(422,420),1),"bridge does not make entire ravine walkable")
    at(s,0,Vector2(355,550));s.controlled=0;tick(s,1,true,Vector2.RIGHT)
    check(s.positions[0].x>500,"normal movement crosses both grown ravine margins on locked bridge")
    gather(s,s.CORE_GATE);s.interact(0);check(s.phase=="shield","all gather to enter core")
    check(not s.walkable(s.MACHINE,0),"machine housing has collision")
    at(s,0,s.SHIELD_SLOT);s.facing[0]=s.positions[0].direction_to(s.MACHINE);s.guard(0,true);tick(s,1.9)
    check(s.failed_sweeps==1 and s.arm_arrest==0,"holding shield from before warning window is not a timed deflection")
    shield_attempt(s,false)
    check(s.failed_sweeps==2 and s.arm_arrest==0 and s.phase=="shield","wrong shield direction causes safe nonlethal reset")
    check(s.walkable(s.positions[0],0),"setback places girl on safe floor")
    shield_attempt(s,true);check(s.arm_arrest>0,"timed directional shield arrests arm")
    var paused_arm:float=s.arm_arrest;var paused_clock:float=s.clock
    tick(s,2,false);check(s.arm_arrest==paused_arm and s.clock==paused_clock,"pause freezes machine and temporary arrest")
    tick(s,6);check(s.arm_arrest==0 and not s.arm_locked,"unlatched arm recovers after time window")
    shield_attempt(s,true)
    at(s,2,s.ARM_LOCK);s.interact(2);check(not s.arm_locked,"white cannot lock hook latch")
    at(s,1,s.ARM_LOCK);s.interact(1)
    check(s.phase=="lure" and s.stage_checkpoint==1 and s.arm_locked,"first machine checkpoint permanent")
    at(s,0,s.WHEEL);s.interact(0);tick(s,3)
    check(s.wheel_progress==0 and not s.lid_open,"wheel cannot open lid before active buffer beam")
    at(s,2,s.AIM_STAND);s.facing[2]=Vector2.LEFT;s.interact(2);tick(s,0.6)
    check(not s.beam_held,"wrong light direction rejected")
    s.facing[2]=Vector2.RIGHT;s.interact(2);s.controlled=1;tick(s,1.2)
    check(s.beam_held and s.wheel_progress>1,"player-assigned light and wheel persist across solo switches")
    var wheel_pause:float=s.wheel_progress;tick(s,1,false)
    check(s.wheel_progress==wheel_pause,"pause does not advance lid repair")
    s.controlled=0;tick(s,0.1,true,Vector2.DOWN);check(not s.wheel_held,"moving girl releases wheel")
    check(s.arm_locked and s.stage_checkpoint==1,"interrupted stage does not lose prior lock")
    tick(s,0.5);s.interact(0);tick(s,2.5)
    check(s.phase=="unjam" and s.lid_open and s.stage_checkpoint==2,"second machine checkpoint locks open lid")
    check(not s.walkable(s.REPAIR_SLOT,1),"unlit repair slot rejects entry")
    at(s,1,s.CRADLE);s.interact(1);check(not s.fixed_light,"black cannot impersonate fixed-light tool")
    at(s,2,s.CRADLE);s.interact(2)
    check(s.fixed_light and s.walkable(s.REPAIR_SLOT,1) and not s.walkable(s.REPAIR_SLOT,0),"cradle opens cat-sized safe inspection slot")
    s.controlled=2;tick(s,0.25,true,Vector2.LEFT);check(s.fixed_light,"fixed cradle does not require continuous white input")
    at(s,1,s.REPAIR_SLOT);s.interact(1);tick(s,1.5)
    check(s.cleared_segments==0,"hook alone cannot pull jam without wheel clearance")
    at(s,0,s.WHEEL);s.interact(0);tick(s,1.0)
    check(s.cleared_segments==1,"hook and wheel create first physical ratchet step")
    s.controlled=0;tick(s,0.1,true,Vector2.DOWN);tick(s,0.5)
    check(s.cleared_segments==1 and s.pull_progress==0 and s.lid_open,"loss of clearance preserves completed ratchet and lid")
    s.interact(0);tick(s,2)
    check(s.phase=="withdraw" and s.machine_stopped and s.stage_checkpoint==3 and not s.finished,"machine stop is not chapter completion")
    at(s,2,s.CRADLE);s.interact(2);check(s.phase=="withdraw" and s.fixed_light,"cannot release safety light while black inside")
    s.controlled=1;tick(s,0.6,true,Vector2.DOWN);s.interact(2)
    check(s.phase=="test" and not s.fixed_light,"black exits before cradle release")
    at(s,0,s.TEST_PLATE);s.facing[0]=Vector2.LEFT;s.interact(0)
    at(s,2,s.TEST_SOURCE);s.facing[2]=Vector2.RIGHT;s.interact(2);tick(s,3.2)
    check(not s.tested and s.test_progress==0,"unadjusted plate cannot fake outward-light test")
    at(s,0,s.TEST_PLATE);s.facing[0]=Vector2.RIGHT;s.interact(0);tick(s,1)
    var test_pause:float=s.test_progress;tick(s,2,false)
    check(s.test_progress==test_pause,"pause freezes proof-beam observation")
    tick(s,2.1);check(s.phase=="release" and s.tested and s.outward_light and not s.network_lit,"actual stable beam evidence precedes network release")
    at(s,1,s.ALIGHT);s.interact(1);check(not s.network_lit,"Alight dialogue requires girl after test")
    at(s,0,s.ALIGHT);s.interact(0);check(s.network_lit and s.phase=="network","Alight voluntarily opens outward gate after evidence")
    gather(s,s.LIFT);s.interact(0);check(s.phase=="farewell","party takes lift to playable farewell route")
    gather(s,s.PORTAL);s.interact(1);check(not s.tag_inserted,"home tag belongs to girl")
    s.interact(0);check(s.tag_inserted and s.phase=="farewell","tag inserted does not alone enter portal")
    tick(s,0.6);s.interact(0);check(s.phase=="farewell","girl confirmation waits for second player")
    s.interact(1);check(s.phase=="home" and not s.finished and s.allow_epilogue,"all three return to genuinely playable home before finish")
    gather(s,s.HOME_SOFA);s.interact(0);check(not s.finished,"voluntary finish requires home arrival activities")
    at(s,0,s.HOME_RACK);s.interact(0);check(s.gear_stored,"girl stores actual adventure equipment")
    gather(s,s.HOME_BOWL);s.interact(0);check(s.paws_clean,"both cats receive paw check")
    gather(s,s.HOME_SOFA);s.interact(0);check(s.finished and s.phase=="complete","voluntary sofa action completes full story")
    var record:Dictionary=s.record();check(record.get("chapter")=="chapter-five" and record.get("completed")==true and record.get("version")==1,"completion uses shared save schema")
    var restored=State.new();restored.restore(record)
    check(restored.finished and restored.phase=="complete" and restored.allow_epilogue and restored.gear_stored,"matching completion restores playable safe home")
    var old_pos:Vector2=restored.positions[0];tick(restored,0.2,true,Vector2.LEFT)
    check(restored.positions[0].x<old_pos.x,"home remains movable after finished save restore")
    var bad=State.new();bad.restore({"version":1,"chapter":"chapter-four","completed":true,"extras":{}})
    check(not bad.finished and bad.phase=="approach","foreign chapter save rejected")
    bad.restore({"version":1,"chapter":"chapter-five","completed":"true","extras":{}})
    check(not bad.finished,"malformed completion type rejected")
    print("M25 chapter five state: %d checks, %d failures"%[checks,failed])
    quit(1 if failed else 0)
