extends SceneTree
const Chapter=preload("res://game/chapter_four_state.gd")
var checks:=0
var failures:=0
func check(ok:bool,note:String)->void:
    checks+=1
    if not ok:failures+=1;push_error(note)
func use(s,role:int,p:Vector2,direction:=Vector2.RIGHT)->void:
    # Unit-test fixtures place actors; the root scene driver uses actual input.
    s.positions[role]=p;s.facing[role]=direction;s.action_time[role]=0;s.interact(role)
func _initialize()->void:
    var s=Chapter.new()
    check(s.joined and s.available_roles()==[0,1,2],"all three stay together")
    check(not s.walkable(Vector2(295,365),0) and not s.walkable(Vector2(295,365),1),"pit is initially impassable")
    s.positions[1]=Vector2(295,450);s.move(1,Vector2(0,-150))
    check(s.positions[1].y>=425,"movement cannot tunnel through dark pit")
    use(s,0,s.HOOK);check(not s.cover_hooked,"girl cannot hook")
    use(s,1,s.HOOK);check(s.cover_hooked,"black cat hooks cover")
    use(s,2,s.MARKET_LIGHT,Vector2.RIGHT);check(not s.market_beam,"wrong facing does not reveal path")
    use(s,2,s.MARKET_LIGHT,s.MARKET_LIGHT.direction_to(s.COVER));check(s.market_beam,"white cat aims at return path")
    check(s.walkable(s.COVER,1) and not s.walkable(s.COVER,0),"only black cat fits narrow plank")
    check(not s.walkable(Vector2(220,365),1) and not s.follow_allowed(1,s.COVER),"light does not remove whole pit or enable follower traversal")
    use(s,1,s.COVER);check(s.cover_carried,"black cat retrieves cover")
    var before=s.positions.duplicate();var before_clock=s.clock
    s.step(0.03,Vector2.RIGHT,Vector2.RIGHT,false)
    check(s.positions==before and s.clock==before_clock and s.market_beam,"pause freezes movement and puzzle state")
    use(s,0,s.CATCH);check(not s.cloth,"girl cannot catch while cat remains in pit")
    s.actions[2]="";s.step(0.016,Vector2.ZERO,Vector2.ZERO,true)
    check(not s.PIT.has_point(s.positions[1]) and s.cover_carried,"loss of light returns cat safely with recovered cover")
    use(s,1,s.CATCH);check(not s.cloth,"cat cannot grant cloth itself")
    use(s,0,s.CATCH);check(s.cloth and s.phase=="meet","girl catches then receives repair cloth")
    use(s,1,s.ALIGHT);check(s.phase=="meet","girl holds conversation")
    use(s,0,s.ALIGHT);check(s.phase=="investigate","Alight permits limited test")
    use(s,1,s.BRANCH);check(not s.branch_seen,"branch remains unseen without light")
    use(s,0,s.ARROWS);check(not s.battle_requested,"cannot infer mechanism before evidence")
    use(s,2,s.DUCT_LIGHT,Vector2.DOWN);check(not s.duct_seen,"wrong duct aim fails")
    use(s,2,s.DUCT_LIGHT,Vector2.UP);check(s.duct_seen,"inward duct revealed")
    use(s,0,s.BRANCH);check(not s.branch_seen,"girl cannot inspect narrow return latch")
    use(s,1,s.BRANCH);use(s,0,s.ARROWS)
    check(s.branch_seen and s.arrows_seen and s.battle_requested,"combined evidence starts first encounter")
    s.after_battle();check(s.phase=="exterior" and s.battles_finished==1,"first battle opens exterior")
    s.after_battle();check(s.battles_finished==1,"repeated battle callback cannot advance encounter count")
    use(s,1,s.LATCH);check(not s.latch_fixed,"unsupported patch cannot latch")
    use(s,2,s.SEAM_LIGHT,s.SEAM_LIGHT.direction_to(s.PATCH));check(not s.seam_seen,"unfixed cloth hides last seam")
    use(s,0,s.PATCH);check(s.patch_braced,"girl braces cloth")
    s.positions[0]+=Vector2(-90,0);s.step(0.016,Vector2.ZERO,Vector2.ZERO,true)
    use(s,1,s.LATCH);check(not s.latch_fixed,"walking away cancels useful brace")
    use(s,0,s.PATCH);use(s,1,s.LATCH);check(s.latch_fixed,"brace and hook permanently fasten cloth")
    s.actions[0]="";s.positions[0]=Vector2(840,480);s.step(0.016,Vector2.ZERO,Vector2.ZERO,true)
    check(s.latch_fixed,"staged latch persists after release")
    use(s,0,s.PATCH);check(not s.shell_fixed,"last hidden seam still required")
    use(s,2,s.SEAM_LIGHT,Vector2.LEFT);check(not s.seam_seen,"wrong seam aim fails")
    use(s,2,s.SEAM_LIGHT,s.SEAM_LIGHT.direction_to(s.PATCH));check(s.seam_seen,"white reveals final seam")
    use(s,1,s.PATCH);check(not s.shell_fixed,"black cat cannot press cloth seam")
    use(s,0,s.PATCH);check(s.shell_fixed and s.battle_requested,"final seam repair starts encounter two")
    s.after_battle();check(s.battles_finished==2 and s.shell_fixed and s.phase=="test","shell survives encounter")
    use(s,0,s.ARROWS);check(s.inward_verified and s.phase=="offer","stable shell still has inward light")
    use(s,0,s.ALIGHT);check(s.lantern_offered and s.phase=="home_offer","real emergency exit offered")
    use(s,0,s.HOME);check(not s.reserve_retained,"wait for both cats at real home offer")
    s.positions[1]=s.HOME+Vector2(-50,10);s.positions[2]=s.HOME+Vector2(50,10)
    use(s,0,s.HOME);check(s.reserve_retained and not s.finished,"fixed help decision preserves lantern")
    check(s.record().is_empty(),"incomplete chapter does not claim completion")
    use(s,0,s.REST);check(not s.finished,"rest requires gathered party")
    s.positions[1]=s.REST+Vector2(-50,15);s.positions[2]=s.REST+Vector2(50,15)
    use(s,0,s.REST);check(s.finished,"gathered rest completes chapter")
    var saved=s.record();var restored=Chapter.new();restored.restore(saved)
    check(restored.finished and restored.shell_fixed and restored.reserve_retained and restored.battles_finished==2,"complete save restores truthful world")
    var other=Chapter.new();var wrong=saved.duplicate(true);wrong.chapter="chapter-three";other.restore(wrong)
    check(not other.finished and not other.shell_fixed,"chapter saves are isolated")
    wrong=saved.duplicate(true);wrong.completed="true";other.restore(wrong);check(not other.finished,"typed completion validation")
    wrong=saved.duplicate(true);wrong.version=99;other.restore(wrong);check(not other.finished,"unsupported save version rejected")
    print("M25 chapter four state: ",checks-failures,"/",checks," checks passed");quit(1 if failures else 0)
