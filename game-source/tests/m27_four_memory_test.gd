extends "res://tests/m27_four_experiment_test.gd"
func run()->void:
    var s=lit_trial();s.cover_hooked=true
    check(s.has_method("trial_records"),"world exposes the three witnessed experiment plaques")
    if not s.has_method("trial_records"):return
    var blank:Array=s.trial_records()
    check(blank.size()==3,"exactly three fixed route diagrams")
    for record in blank:check(not record.seen and record.result=="","unseen route has no fabricated result")
    # Deliberately isolated -> main -> connected; diagrams are not an answer order.
    touch(s,1,s.BRANCH);touch(s,0,s.ARROWS);send(s)
    var marks:Array=s.trial_records()
    check(not marks[0].seen and not marks[1].seen and marks[2].seen and marks[2].result=="留光","isolated trial writes only its own mark")
    var restored=Four.new()
    check(restored.restore_checkpoint(s.checkpoint()),"partial real evidence checkpoint restores")
    check(restored.trial_records()==marks,"restore preserves only witnessed plaques")
    check(restored.reserve_charge==0 and not restored.pulse_active,"memory is not fictitious live power")
    touch(s,0,s.ARROWS);send(s)
    check(s.trial_records()[0].seen and not s.trial_records()[1].seen,"main after isolated leaves connected result unknown")
    touch(s,0,s.ARROWS);touch(s,1,s.BRANCH);send(s)
    marks=s.trial_records()
    check(marks[0].result=="回流" and marks[1].result=="回流" and marks[2].result=="留光","all three real observations remain comparable")
    send(s);check(s.trial_records()==marks and s.trial_records().size()==3,"repeating sample never duplicates a plaque")
    s.action_time[2]=0;s.tool(2)
    check(s.trial_records()==marks,"withdrawing light leaves observations intact")
    check(restored.restore_checkpoint(s.checkpoint()) and restored.trial_records()==marks,"restart retains comparison")
    touch(s,0,s.ALIGHT);s.after_battle()
    touch(s,0,s.PATCH);touch(s,1,s.LATCH)
    s.facing[2]=s.positions[2].direction_to(s.PATCH)
    s.positions[2]=s.SEAM_LIGHT;s.facing[2]=s.SEAM_LIGHT.direction_to(s.PATCH)
    s.action_time[2]=0;s.interact(2)
    touch(s,0,s.PATCH)
    check(s.shell_fixed and not s.inward_verified,"repair alone does not fabricate a post-repair trial")
    check(s.trial_records()==marks,"shell repair does not rewrite earlier observations")
    touch(s,2,s.DUCT_LIGHT);s.facing[2]=Vector2.UP;s.action_time[2]=0
    if not s.trial_lit():s.interact(2)
    send(s)
    check(s.inward_verified and s.leak_charge==0 and s.return_charge>0,"real retest separates sealed shell from remaining return")
    touch(s,0,s.ALIGHT)
    check(s.phase=="home_offer" and s.message.contains("主线") and s.message.contains("回家"),"home offer distinguishes safe reserve from unresolved mainline")
    s.positions.assign([s.HOME,s.HOME+Vector2(32,0),s.HOME+Vector2(-32,0)])
    s.action_time[0]=0;s.interact(0)
    check(s.reserve_retained and s.message.contains("决定留下"),"girl explicitly chooses to stay with safe return retained")
