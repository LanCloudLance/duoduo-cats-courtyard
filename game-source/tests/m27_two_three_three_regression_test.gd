extends SceneTree
## State fixtures: no claim of natural keyboard play or user playtesting.
var checks:=0
var failed:=0
func check(v:bool,label:String)->void:
    checks+=1
    if not v:failed+=1;push_error("FAIL: "+label)
func ticks(s,n:=60)->void:
    for i in range(n):s.step(1.0/60,Vector2.ZERO,Vector2.ZERO,true)
func touch(s,role:int,p:Vector2)->void:
    s.positions[role]=p;s.interact(role);ticks(s)
func _initialize()->void:call_deferred("run")
func run()->void:
    var script=load("res://game/chapter_three_state.gd")
    var s=script.new()
    check(not s.joined and s.available_roles()==[0,1],"white cannot be controlled before reunion")
    check(not s.walkable(Vector2(460,420),1) and not s.walkable(s.DUCT,0),"sealed door and cat-only exterior duct have collision")
    s.positions[2]=s.WINDOW;s.interact(2);check(not s.npc_called,"locked actor cannot trigger scripted NPC")
    touch(s,0,s.WINDOW);check(not s.npc_called,"unpowered door ignores cue")
    touch(s,1,s.DUCT);touch(s,0,s.DOOR_LAMP)
    check(s.wick_found and not s.wick_fitted,"finding wick is not delivering it")
    touch(s,1,s.DOOR_LAMP);touch(s,0,s.DOOR_LAMP);ticks(s,180)
    check(s.wick_fitted and not s.door_open and not s.npc_called,"time and fitting alone cannot move NPC")
    touch(s,0,s.DOOR_LAMP);touch(s,1,s.WINDOW)
    check(not s.npc_called,"cat cannot issue girl's explicit cue")
    touch(s,0,s.WINDOW);ticks(s,100)
    check(s.door_open and not s.joined and s.positions[2].distance_to(s.INDOOR_PLATE)<1,"cue scripts indoor plate but control remains locked")
    s.positions[1]=Vector2(250,420);touch(s,0,s.REUNION)
    check(not s.joined,"reunion requires girl and Tuan nearby")
    s.positions[1]=Vector2(425,420);touch(s,0,s.REUNION)
    check(not s.joined,"nearby cat outside doorway cannot trigger indoor reunion")
    s.positions[1]=s.REUNION+Vector2(25,25);touch(s,0,s.REUNION)
    check(s.joined and s.available_roles()==[0,1,2],"reunion explicitly unlocks third role")
    touch(s,0,s.EQUIPMENT)
    s.facing[2]=Vector2.LEFT;touch(s,2,s.LIGHT_STAND)
    check(not s.beam_active() and not s.walkable(Vector2(760,420),1),"wrong beam angle leaves real gap")
    s.tool(2);ticks(s);s.facing[2]=Vector2.RIGHT;touch(s,2,s.LIGHT_STAND)
    check(s.beam_active() and s.walkable(Vector2(760,420),1) and not s.walkable(Vector2(760,420),0),"stable beam creates precise cat route only")
    s.positions[1]=Vector2(760,420);s.tool(2);ticks(s)
    check(s.positions[1].x<700 and not s.bridge_locked,"light release before lock safely returns cat")
    s.facing[2]=Vector2.RIGHT;touch(s,2,s.LIGHT_STAND);touch(s,1,s.LOCK)
    check(s.cat_lock and not s.bridge_locked,"cat latch alone is insufficient")
    touch(s,1,s.BOARD);check(s.board_angle==0,"cat cannot turn high board")
    touch(s,0,s.BOARD)
    s.tool(2);ticks(s);s.facing[2]=Vector2.UP;touch(s,2,s.LIGHT_STAND)
    check(s.bridge_locked and s.walkable(Vector2(760,420),0),"three-role linked puzzle permanently locks bridge")
    s.controlled=2
    for i in range(50):s.step(1.0/60,Vector2.RIGHT,Vector2.ZERO,true)
    check(not s.beam_held and not s.light_released and s.positions[2].x>700,"moving across fixed bridge stops beam without implicitly acknowledging release")
    s.tool(0);ticks(s)
    check(not s.light_released,"girl tool cannot acknowledge white cat release")
    var before_release:Array=s.positions.duplicate()
    s.tool(2);ticks(s)
    check(s.light_released and not s.beam_held and s.walkable(Vector2(760,420),2),"explicit release preserves crossing for all three")
    check(s.positions==before_release,"white can explicitly finish release after moving away without relighting or teleporting")
    s.controlled=0
    touch(s,0,s.RIG);check(not s.rig_ready,"rig cannot be fitted before Tuan opens narrow route")
    touch(s,1,s.NARROW);touch(s,0,s.RIG)
    s.facing[2]=Vector2.UP;touch(s,2,s.SEARCH_STAND)
    check(not s.exit_revealed,"new light search needs intentional direction")
    s.tool(2);ticks(s);s.facing[2]=Vector2.RIGHT;touch(s,2,s.SEARCH_STAND)
    touch(s,0,s.SEARCH_STAND);s.facing[2]=Vector2.RIGHT;touch(s,2,s.SEARCH_STAND)
    touch(s,0,s.RIG);touch(s,1,s.HIGH_RING)
    check(s.exit_revealed and s.exit_low_latched and s.exit_high_latched and s.walkable(Vector2(990,305),0),"both height layouts open permanent true exit")
    s.positions[1]=Vector2(960,305);s.positions[2]=s.MAP+Vector2(35,25);touch(s,0,s.MAP)
    check(not s.finished,"map gathering requires everyone beyond physical exit wall")
    s.positions[1]=s.MAP;s.positions[2]=s.MAP+Vector2(35,25);touch(s,0,s.MAP)
    check(s.finished and s.joined and s.extras.get("inward_route",false),"map finish retains both cats and inward-flow evidence")
    var r=script.new();r.restore(s.record())
    check(r.finished and r.joined and r.bridge_locked and r.exit_revealed,"completed save restores all paths and companions")
    var bad=script.new();bad.restore({"version":1,"chapter":"chapter-two","completed":true})
    check(not bad.finished and not bad.joined,"wrong chapter completion rejected")
    print("M27_TWO_THREE_THREE_REGRESSION: %d checks, %d failed (state fixtures)"%[checks,failed]);quit(1 if failed else 0)
