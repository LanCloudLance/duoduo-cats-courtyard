extends SceneTree
var checks:=0
var failed:=0
func check(v:bool,label:String)->void:
    checks+=1
    if not v:failed+=1;push_error("FAIL: "+label)
func ticks(s,n:int)->void:
    for i in range(n):s.step(1.0/60,Vector2.ZERO,Vector2.ZERO,true)
func touch(s,role:int)->void:
    s.interact(role);ticks(s,60)
func _initialize()->void:call_deferred("run")
func run()->void:
    check(ResourceLoader.exists("res://game/chapter_one_state.gd"),"chapter simulation exists")
    if not ResourceLoader.exists("res://game/chapter_one_state.gd"):
        print("M24_STATE: %d checks, %d failed"%[checks,failed]);quit(1);return
    var script=load("res://game/chapter_one_state.gd")
    var s=script.new()
    check(not s.walkable(Vector2(620,400),0),"fallen trunk blocks real path")
    check(not s.walkable(Vector2(620,570),1),"cat cannot bypass a loaded trunk")
    s.phase="road"
    s.positions[0]=s.LIFT;touch(s,0)
    check(s.bracing and s.walkable(Vector2(620,570),1) and not s.walkable(Vector2(620,570),0),"lifting opens a cat sized inspection route")
    s.positions[1]=s.FORK;touch(s,1)
    check(s.carrier==1,"cat can carry a physical support")
    s.positions[1]=Vector2(585,280);touch(s,1)
    check(not s.supported and s.carrier==1,"supporting wrong end changes feedback but does not solve load")
    s.positions[1]=s.SOCKET;touch(s,1)
    check(s.supported and s.carrier==-1,"physical support frees girl without AI puzzle solve")
    s.step(1.0/60,Vector2.LEFT,Vector2.ZERO,true)
    check(not s.bracing and s.walkable(Vector2(620,570),1),"support preserves route when girl steps away")
    s.positions[1]=s.KNOT;touch(s,1)
    check(s.branch_clear and s.walkable(Vector2(620,400),0),"cat releases unloaded knot and permanent path opens")
    s.positions[0]=s.ROAD_EXIT;s.positions[1]=Vector2(200,400);touch(s,0)
    check(not s.battle_requested,"cannot leave a distant partner behind")
    s.positions[1]=s.ROAD_EXIT;touch(s,0)
    check(s.battle_requested,"both reach encounter entrance")
    s.enter_station()
    s.positions[1]=s.BENCH;touch(s,1)
    check(s.carrier==1 and s.core_found,"cat finds actual missing wick")
    s.positions[1]=s.LAMP;touch(s,1)
    check(s.core_ready and s.carrier==-1,"cat delivers wick to lamp, not instant repair")
    s.positions[0]=s.LAMP;touch(s,0)
    check(s.core_installed,"girl fits recovered wick")
    s.hood=3;s.vent=1;ticks(s,240)
    check(not s.lit and s.flame<0.1,"windward opening extinguishes flame despite correct air vent")
    s.hood=1;s.vent=0;ticks(s,240)
    check(not s.lit,"sealed vent cannot keep flame alive")
    s.vent=2;ticks(s,240)
    check(not s.lit,"too much draft cannot keep flame alive")
    s.vent=1;ticks(s,240)
    check(s.lit and s.phase=="rest","leeward hood and small vent stabilize lamp")
    s.positions[0]=s.PILLOW;touch(s,0)
    check(s.clue_seen,"white fur and flattened pillow reveal Yuanyuan's route")
    s.positions[0]=s.SEAT;s.positions[1]=Vector2(150,400);touch(s,0)
    check(not s.finished,"chapter rest needs both companions present")
    s.positions[1]=s.SEAT+Vector2(35,0);touch(s,0);ticks(s,90)
    check(s.finished and s.extras.get("route",false),"rest finishes chapter with next route clue")
    var record:Dictionary=s.record()
    var restored=script.new();restored.restore(record)
    check(restored.finished and restored.lit and restored.branch_clear,"own chapter progress restores without sample progress")
    var invalid=script.new();invalid.restore({"chapter":"prologue","completed":true})
    check(not invalid.finished,"unrelated story record cannot impersonate completion")
    var other=script.new();other.phase="road";other.positions[0]=other.LIFT;touch(other,0);other.positions[1]=Vector2(650,570)
    other.step(1.0/60,Vector2.LEFT,Vector2.ZERO,true)
    check(other.positions[1].x<600,"losing support returns cat to safe side without trapping")
    var before: Array=other.positions.duplicate();var t:float=other.clock
    other.step(0.1,Vector2.RIGHT,Vector2.RIGHT,false)
    check(before==other.positions and t==other.clock,"disabled updates preserve puzzle state")
    print("M24_STATE: %d checks, %d failed"%[checks,failed]);quit(1 if failed else 0)
