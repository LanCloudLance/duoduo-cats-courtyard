extends "res://tests/keyboard_scene_test.gd"
const Store = preload("res://game/checkpoint.gd")
const SINGLE := "user://test-m11-mode-solo.json"
const DUAL := "user://test-m11-mode-dual.json"
func run() -> void:
    for path in [SINGLE,DUAL]: DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
    lobby = load("res://main.tscn").instantiate()
    lobby.solo_checkpoint = Store.new(SINGLE)
    lobby.checkpoint = Store.new(DUAL)
    root.add_child(lobby)
    await frames(2)
    lobby.session.set_focus(true)
    # Native event route selects a mode without mouse or keyboard.
    button(9,JOY_BUTTON_DPAD_DOWN)
    check(lobby.get_viewport().gui_get_focus_owner() == lobby.get_node("StorySolo"),"D-pad starts at new prologue entry")
    for i in range(8):
        if lobby.get_viewport().gui_get_focus_owner() == lobby.get_node("SingleJourney"): break
        button(9,JOY_BUTTON_DPAD_DOWN)
    check(lobby.get_viewport().gui_get_focus_owner() == lobby.get_node("SingleJourney"),"D-pad highlights single journey")
    button(9,JOY_BUTTON_A)
    check(lobby.session.single_player and not lobby.session.keyboard_mode and not lobby.session.running(),"controller menu selects solo and awaits ready")
    check(lobby.stage=="prologue","from-head controller menu now enters complete story")
    lobby.start_courtyard(true)
    button(9,JOY_BUTTON_START)
    await frames(2)
    check(lobby.session.running() and not lobby.session.ready_flags[1],"single controller begins full journey")
    var event := InputEventJoypadMotion.new()
    event.device = 9
    event.axis = JOY_AXIS_LEFT_X
    event.axis_value = 1
    Input.parse_input_event(event)
    Input.flush_buffered_events()
    await frames(5)
    button(9,JOY_BUTTON_Y)
    var cat: Vector2 = lobby.courtyard.party.positions[1]
    await frames(5)
    check(lobby.courtyard.selection.actor == 1 and lobby.courtyard.party.positions[1] == cat,"pad switch clears held movement")
    button(9,JOY_BUTTON_B)
    check(lobby.courtyard.selection.actor == 0,"pad B quick returns previous puzzle actor")
    lobby._connection_changed(9,false)
    var pos: Array = lobby.courtyard.party.positions.duplicate()
    await frames(6)
    check(not lobby.session.running() and lobby.courtyard.party.positions == pos,"single pad disconnect freezes puzzle")
    button(12,JOY_BUTTON_START)
    button(12,JOY_BUTTON_START)
    await frames(3)
    check(lobby.session.running() and lobby.courtyard.party.positions[0] == pos[0],"replacement pad resumes without stale motion")
    button(12,JOY_BUTTON_START)
    lobby.get_node("ReplayCourtyard").pressed.emit()
    check(lobby.session.single_player and lobby.courtyard.bridge.solo_mode and lobby.courtyard.bridge.unlocked == 0,"replay preserves single puzzle rules")
    # Explicit save fixtures only for isolation and corrupted-record handling.
    var data := {"version":1,"safe_point":"rest","rested":true,"current_cat":2,"completed":{"bridge":true,"combat":true,"light":true}}
    check(lobby.solo_checkpoint.save_checkpoint(data),"solo save fixture accepted")
    data.current_cat = 1
    check(lobby.checkpoint.save_checkpoint(data),"legacy dual v1 fixture accepted")
    lobby.resume_courtyard(true)
    check(lobby.session.single_player and lobby.rest_area.state.current_cat == 2 and lobby.rest_area.state.solo_mode,"solo resume restores solo rules and cat")
    lobby.resume_checkpoint()
    check(not lobby.session.single_player and lobby.rest_area.state.current_cat == 1 and not lobby.rest_area.state.solo_mode,"dual resume reads separate legacy record")
    lobby.session.pause_all()
    lobby.get_node("SoloCombatPreview").pressed.emit()
    check(lobby.preview_run and not lobby.arena.allow_next_level,"solo combat preview stays bounded")
    lobby.session.pause_all()
    lobby.start_courtyard(true)
    lobby.enter_combat()
    check(not lobby.preview_run and lobby.arena.allow_next_level,"full solo combat allows later light transition")
    lobby.session.pause_all()
    lobby.get_node("ReplayCourtyard").pressed.emit()
    check(lobby.arena.allow_next_level and lobby.arena.battle.solo_mode,"combat retry preserves full solo journey")
    lobby.start_preview("light")
    check(lobby.preview_run and not lobby.session.single_player and not lobby.light_corridor.puzzle.solo_mode,"dual preview leaves single puzzle rules")
    lobby.session.pause_all()
    lobby.start_preview("rest")
    check(not lobby.rest_area.can_save and not lobby.rest_area.state.rested,"rest preview starts fresh without save authority")
    lobby.rest_area.state.rested = true
    lobby.session.pause_all()
    lobby.start_preview("rest")
    check(not lobby.rest_area.state.rested,"reopening rest preview resets finished visit")
    check(lobby.solo_checkpoint.read_checkpoint().current_cat == 2 and lobby.checkpoint.read_checkpoint().current_cat == 1,"all previews preserve both records")
    for path in [SINGLE,DUAL]: DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
    print("JOURNEY_MODES: %d checks, %d failed" % [checks,failed])
    quit(1 if failed else 0)
