extends "res://tests/keyboard_scene_test.gd"
# Real key/button events catch missing release routing and stale held attacks.
func run() -> void:
    lobby = load("res://main.tscn").instantiate()
    root.add_child(lobby)
    await frames(2)
    lobby.session.set_focus(true)
    lobby.get_node("CombatPreview").pressed.emit()
    var b = lobby.arena.battle
    b.current_cat = 2
    b.positions[2] = Vector2(350,440)
    b._spawn("thorn",Vector2(410,440))
    var e: Dictionary = b.enemies[0]
    e.hp = 30
    e.max_hp = 30
    key_event(KEY_J,true)
    check(e.hp == 30,"keyboard press does not prematurely slap")
    key_event(KEY_J,false)
    await frames(9)
    check(e.hp == 29,"keyboard J release performs light slap")
    await frames(50)
    key_event(KEY_J,true)
    await frames(45)
    check(e.hp == 29,"keyboard hold charges without auto firing")
    key_event(KEY_J,false)
    await frames(9)
    check(e.hp == 26,"keyboard held release performs heavy slap")
    await frames(60)
    b.positions[2] = e.pos-Vector2(60,0)
    key_event(KEY_J,true)
    await frames(45)
    tap_key(KEY_ESCAPE)
    var saved: Vector2 = b.positions[2]
    await frames(4)
    check(not lobby.session.running() and b.positions[2] == saved,"pause freezes pending attack scene")
    tap_key(KEY_ENTER)
    key_event(KEY_J,false)
    await frames(9)
    check(e.hp == 26,"release after keyboard pause does not fire old charge")
    key_event(KEY_J,true)
    await frames(45)
    tap_key(KEY_TAB)
    tap_key(KEY_TAB)
    key_event(KEY_J,false)
    await frames(9)
    check(e.hp == 26,"switch away and back cannot bank charge")
    key_event(KEY_J,true)
    await frames(45)
    lobby.notification(MainLoop.NOTIFICATION_APPLICATION_FOCUS_OUT)
    lobby.notification(MainLoop.NOTIFICATION_APPLICATION_FOCUS_IN)
    tap_key(KEY_ENTER)
    key_event(KEY_J,false)
    await frames(9)
    check(e.hp == 26,"focus loss clears charge without a release attack")
    # Synthetic gamepads exercise the production input route, not real hardware.
    lobby.router.use_gamepads()
    for device in [9,18,9,18]: button(device,JOY_BUTTON_START)
    b.positions[2] = e.pos-Vector2(60,0)
    pad_attack(true)
    pad_attack(false)
    await frames(9)
    check(e.hp == 25,"controller X press-release performs one light slap")
    await frames(50)
    pad_attack(true)
    await frames(45)
    pad_attack(false)
    await frames(9)
    check(e.hp == 22,"controller X hold-release performs one heavy slap")
    await frames(60)
    b.positions[2] = e.pos-Vector2(60,0)
    pad_attack(true)
    await frames(45)
    lobby.session.release_slot(1)
    await frames(2)
    check(not lobby.session.running(),"controller disconnect pauses combat")
    for device in [18,9,18]: button(device,JOY_BUTTON_START)
    pad_attack(false)
    await frames(9)
    check(e.hp == 22,"disconnect and reconnect cannot release stored heavy")
    print("ATTACK_INPUT: %d checks, %d failed" % [checks,failed])
    quit(1 if failed else 0)
func pad_attack(down: bool) -> void:
    var event := InputEventJoypadButton.new()
    event.device = 18
    event.button_index = JOY_BUTTON_X
    event.pressed = down
    Input.parse_input_event(event)
    Input.flush_buffered_events()
