extends "res://tests/prologue_scene_test.gd"
func run() -> void:
    check(OS.get_user_data_dir().ends_with("DuoduoCatsCourtyard-qa-m27-prologue"),"isolated actual prologue namespace")
    print("QA_USERDIR: "+OS.get_user_data_dir())
    lobby = load("res://main.tscn").instantiate()
    root.add_child(lobby)
    await frames(3)
    lobby.session.set_focus(true)
    home = lobby.prologue
    home.record_prefix = "qa-prologue-input-"+str(Time.get_ticks_usec())
    lobby.start_story(true)
    s = home.state
    await frames(2)
    key_event(KEY_D,true)
    await frames(3)
    var first: Vector2 = s.positions[0]
    var second: Vector2 = s.positions[1]
    tap_key(KEY_TAB)
    await frames(4)
    check(s.positions[0] == first and s.positions[1].x > second.x,"held keyboard movement transfers on Tab")
    tap_key(KEY_Q)
    await frames(3)
    check(s.controlled == 0 and s.positions[0].x > first.x,"held movement survives B/Q switch back")
    key_event(KEY_D,false)
    tap_key(KEY_R)
    check(s.hint_level == 0 and s.message.contains("门挡"),"R is contextual ability, never hint")
    tap_key(KEY_G)
    check(s.message.contains("耳朵"),"G remains explicit hint")
    await frames(35)
    check(FileAccess.file_exists(home.checkpoint_path()),"debounced save exists during play")
    key_event(KEY_D,true)
    tap_key(KEY_ESCAPE)
    await frames(2)
    var p: Vector2 = s.positions[0]
    tap_key(KEY_ENTER)
    await frames(4)
    check(s.positions[0] == p,"pause still clears held movement")
    key_event(KEY_D,true)
    lobby.notification(MainLoop.NOTIFICATION_APPLICATION_FOCUS_OUT)
    await frames(2)
    lobby.notification(MainLoop.NOTIFICATION_APPLICATION_FOCUS_IN)
    tap_key(KEY_ENTER)
    await frames(3)
    check(s.positions[0] == p,"focus still clears held movement")
    # Legacy completion is read-only compatible; valid v2 takes precedence.
    lobby.session.pause_all()
    home.reset(false,false)
    home.record_prefix += "-legacy"
    var file := FileAccess.open(home.record_path(),FileAccess.WRITE)
    file.store_string(JSON.stringify({"version":1,"chapter":"prologue","completed":true,"extras":{"toy":true}}))
    file.close()
    home.reset(false,true)
    check(home.state.finished and home.state.extras.get("toy"),"legacy completed record resumes")
    home.reset(false,false)
    home.state.phase = "jam"
    home.state.rug_pull = 35
    home.state.wedged = true
    check(home.save_checkpoint(),"atomic v2 write succeeds")
    check(not FileAccess.file_exists(home.checkpoint_path()+".tmp"),"successful rename leaves no partial file")
    home.reset(false,true)
    check(not home.state.finished and home.state.rug_pull == 35,"valid v2 mid-progress wins over old completion")
    var original := FileAccess.get_file_as_string(home.checkpoint_path())
    DirAccess.make_dir_absolute(home.checkpoint_path()+".tmp")
    check(not home.save_checkpoint(),"failed temp write reports failure")
    check(FileAccess.get_file_as_string(home.checkpoint_path()) == original,"failed temp write preserves valid record")
    DirAccess.remove_absolute(home.checkpoint_path()+".tmp")
    home.state.phase = "invalid"
    check(not home.save_checkpoint(),"invalid source refuses save")
    check(FileAccess.get_file_as_string(home.checkpoint_path()) == original,"rejected save preserves previous record")
    file = FileAccess.open(home.checkpoint_path(),FileAccess.WRITE)
    file.store_string("{broken")
    file.close()
    home.reset(false,true)
    check(home.state.finished,"broken v2 falls back to valid legacy completion")
    print("M27_PROLOGUE_INPUT: %d checks, %d failed" % [checks,failed])
    quit(1 if failed else 0)
